# AI Battery Safety Guardian - Environment Configuration

# LLM Provider: "groq" (default) or "template" (offline fallback)
LLM_PROVIDER=groq

# Groq Cloud API Credentials
GROQ_API_KEY=gsk_your_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Optional Alternative Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
